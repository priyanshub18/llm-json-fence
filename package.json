{
  "name": "llm-json-fence",
  "version": "1.0.0",
  "description": "Zero-dependency streaming & defensive JSON extractor and repair engine for LLM outputs",
  "keywords": [
    "llm",
    "json",
    "parser",
    "streaming",
    "partial-json",
    "json-repair",
    "markdown-fence",
    "ai",
    "openai",
    "gemini",
    "anthropic",
    "typescript",
    "zero-dependency"
  ],
  "homepage": "https://github.com/priyanshub18/llm-json-fence#readme",
  "bugs": {
    "url": "https://github.com/priyanshub18/llm-json-fence/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priyanshub18/llm-json-fence.git"
  },
  "license": "MIT",
  "author": "Priyanshu Bhardwaj <priyanshubhardwaj658@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx scripts/bench.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
